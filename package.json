    "tap": "^18.6.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">= 18.0.0"
  }
